# -----------------------------------------------------------------------------
# INFISICAL SETUP
# -----------------------------------------------------------------------------
# This project uses Infisical to manage secrets and environment variables.
# 
# 1. Install Infisical CLI: https://infisical.com/docs/cli/overview
# 2. Login: `infisical login`
# 3. Initialize: `infisical init` (Choose the project)
# 4. Starting development: `infisical run -- npm run dev`
# -----------------------------------------------------------------------------

# Supabase Configuration
# You can find these in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend Mail Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# Authentication
# A random string for JWT encryption. You can generate one with `openssl rand -base64 32`
JWT_SECRET=

# AI Services
# Zhipu AI API Key for transaction parsing
ZHIPU_AI_API_KEY=

# Deployment
# The base URL of your application (e.g. http://localhost:3000 for development)
NEXT_PUBLIC_SITE_URL=http://localhost:3000